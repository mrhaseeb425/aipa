<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f4f4f4;
      font-family: Arial, sans-serif;
    "
  >
    <table width="100%" cellpadding="0" cellspacing="0" style="padding: 40px 0">
      <tr>
        <td align="center">
          <table
            width="420"
            cellpadding="0"
            cellspacing="0"
            style="background: #ffffff; padding: 30px; border-radius: 10px"
          >
            <!-- Heading -->
            <tr>
              <td align="center" style="padding-bottom: 20px">
                <h2 style="margin: 0; color: #333">
                  <%= title || "Verify Your Email" %>
                </h2>
              </td>
            </tr>

            <!-- Message -->
            <tr>
              <td
                align="center"
                style="color: #666; font-size: 14px; padding-bottom: 25px"
              >
                Use the OTP below to continue.
              </td>
            </tr>

            <!-- OTP Box -->
            <tr>
              <td align="center" style="padding-bottom: 25px">
                <div
                  style="
                    display: inline-block;
                    background: #ff2e63;
                    color: #ffffff;
                    font-size: 30px;
                    letter-spacing: 8px;
                    padding: 15px 30px;
                    border-radius: 8px;
                    font-weight: bold;
                  "
                >
                  <%= otp || "000000" %>
                </div>
              </td>
            </tr>

            <!-- Expiry -->
            <tr>
              <td
                align="center"
                style="color: #999; font-size: 13px; padding-bottom: 20px"
              >
                This code will expire in
                <strong
                  ><%= typeof expiry !== "undefined" ? expiry : 6 %>
                  minutes</strong
                >
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td align="center" style="font-size: 12px; color: #aaa">
                If you did not request this, please ignore this email.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
